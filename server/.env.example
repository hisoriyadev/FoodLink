# Environment & Port Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-deployment.vercel.app

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodlink?retryWrites=true&w=majority

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_minimum_32_chars
JWT_EXPIRE=30d

# Email Transporter (Nodemailer - Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="FoodLink <noreply@foodlink.org>"

# Google Maps API Key (Optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
